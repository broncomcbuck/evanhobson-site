---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Evan Hobson"
  description="Evan Hobson, wildlife ecology student at BYU working on cattle and feral horse movement."
>
  <div class="page home">
    <div class="who-grid">
      <div class="photo">
        <img src="/images/evan.jpg" alt="Evan Hobson" loading="eager" />
      </div>
      <div class="who">
        <h1>Evan Hobson</h1>
        <p>
          I study Wildlife and Wildlands Conservation at Brigham Young University and graduate in
          April 2027. In the BYU Rangeland Ecology Lab I analyze GPS collar data from cattle grazing
          cheatgrass-invaded sagebrush steppe in southeastern Idaho. I am applying to graduate
          programs in movement ecology for fall 2027.
        </p>
        <p class="contact">
          <a href="mailto:evanjhobson@gmail.com">evanjhobson@gmail.com</a>
          <span class="sep">·</span>
          <a href="/cv">CV</a>
          <span class="sep">·</span>
          <a href="https://github.com/broncomcbuck">GitHub</a>
        </p>
      </div>
    </div>

    <h2>Current work</h2>
    <ul class="plain">
      <li>
        <a href="/research#cattle-rsf">Cattle resource selection in cheatgrass-invaded rangelands</a>.
        Lead author, manuscript with coauthors for review.
      </li>
      <li>
        <a href="/research#horses">Feral horse movement and space use in northwestern Nevada</a>.
        Manuscript in preparation.
      </li>
      <li>
        <a href="/research#field">Rangeland vegetation monitoring</a> for SageSTEP and a targeted
        sheep-grazing study, summer 2026.
      </li>
    </ul>

    <h2>Elsewhere on the site</h2>
    <ul class="plain">
      <li><a href="/projects">Projects</a>: Game of Life ash statistics and a scripture text-analysis script.</li>
      <li><a href="/writing">Writing</a>: an essay on emotion and spiritual growth.</li>
    </ul>
  </div>

  <style>
    .who-grid {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 1.6rem;
      align-items: start;
    }

    .photo img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border: 1px solid var(--ink);
    }

    .who h1 {
      margin-top: 0;
    }

    .who p {
      margin: 0 0 0.8rem;
      line-height: 1.7;
    }

    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .sep {
      color: var(--ink-2);
    }

    ul.plain {
      margin: 0;
      padding-left: 1.2rem;
    }

    ul.plain li {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }

    @media (max-width: 640px) {
      .who-grid {
        grid-template-columns: 1fr;
      }

      .photo {
        max-width: 180px;
      }
    }
  </style>
</BaseLayout>
