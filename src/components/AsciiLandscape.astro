---
// One continuous procedurally generated ASCII scene spanning the
// entire page: sky/stars at the top, descending through far/mid/near/
// fore terrain bands to a dense vegetation + wildlife ground band at
// the bottom. Absolutely positioned (inset:0) inside BaseLayout's
// .page-wrap, which is sized by real page content plus a reserved
// .ground-space spacer — see BaseLayout.astro. Regenerated on every
// load/resize; picks a random biome (pine / desert / steppe) each
// time, each with its own terrain-shape math, vegetation, and CSS
// palette (data-biome attr). Single merged character grid so nearer
// ridges properly occlude farther ones. No background — only the
// glyphs themselves carry color, the page's own background shows
// through everywhere else.
---

<div class="ascii-landscape" id="ascii-landscape" aria-hidden="true">
  <pre class="ascii-landscape-art" id="ascii-landscape-art"></pre>
  <div class="ascii-landscape-weather" id="ascii-landscape-weather"></div>
</div>

<script>
  type Cell = { ch: string; layer: string } | null;
  type WeatherKind = "birds" | "leaves" | "cloud";
  type VegShape = { dx: number; dy: number; ch: string }[];

  type Biome = {
    name: string;
    ridged: boolean;
    waveCount: number;
    freqRange: [number, number];
    ampScale: number;
    farMidFlatten: number;
    farFill: string[];
    midFill: string[];
    foreFill: string[];
    midDetailChar: string;
    midDetailDensity: number;
    veg: "tree" | "shrub" | "cactus";
    vegDensity: number;
    snowCaps: boolean;
    grazer: boolean;
    fence: boolean;
    weather: WeatherKind[];
    precip: "snow" | "rain" | null;
  };

  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min;
  }

  function pick<T>(arr: T[]): T {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  const BIOMES: Biome[] = [
    {
      name: "pine",
      ridged: true,
      waveCount: 3,
      freqRange: [0.9, 2.6],
      ampScale: 1,
      farMidFlatten: 1,
      farFill: [".", ".", ".", "'"],
      midFill: [":", ":", ":", "-"],
      foreFill: [",", ",", "'", "."],
      midDetailChar: "^",
      midDetailDensity: 0.07,
      veg: "tree",
      vegDensity: 0.22,
      snowCaps: true,
      grazer: false,
      fence: false,
      weather: ["birds", "leaves", "cloud"],
      precip: "snow",
    },
    {
      name: "desert",
      ridged: false,
      waveCount: 2,
      freqRange: [0.4, 1.1],
      ampScale: 0.85,
      farMidFlatten: 0.45,
      farFill: ["~", "~", "~", "."],
      midFill: ["~", "~", "~", ":"],
      foreFill: [".", ",", "~", "."],
      midDetailChar: "o",
      midDetailDensity: 0.06,
      veg: "cactus",
      vegDensity: 0.1,
      snowCaps: false,
      grazer: false,
      fence: false,
      weather: ["birds", "cloud"],
      precip: null,
    },
    {
      name: "steppe",
      ridged: false,
      waveCount: 2,
      freqRange: [0.5, 1.2],
      ampScale: 0.55,
      farMidFlatten: 1,
      farFill: [".", ".", ".", "'"],
      midFill: [":", ":", ":", "-"],
      foreFill: [",", ",", "'", ";"],
      midDetailChar: "'",
      midDetailDensity: 0.08,
      veg: "shrub",
      vegDensity: 0.27,
      snowCaps: false,
      grazer: true,
      fence: true,
      weather: ["birds", "leaves", "cloud"],
      precip: "rain",
    },
  ];

  // Sum of a few sine waves. Plain sine sum -> smooth rolling terrain.
  // "Ridged" sum (1 - |sin|) per octave -> sharp cusped peaks over
  // flatter valleys, the standard trick for jagged mountain silhouettes.
  function makeWaveFn(waveCount: number, ridged: boolean, freqRange: [number, number]) {
    const waves = [];
    for (let i = 0; i < waveCount; i++) {
      waves.push({
        freq: rand(freqRange[0], freqRange[1]) * (i + 1),
        amp: rand(0.4, 1) / (i + 1),
        phase: rand(0, Math.PI * 2),
      });
    }
    const ampSum = waves.reduce((s, w) => s + w.amp, 0);
    return (t: number) => {
      let h = 0;
      for (const w of waves) {
        let v = Math.sin(t * Math.PI * 2 * w.freq + w.phase);
        if (ridged) v = 1 - Math.abs(v);
        h += v * w.amp;
      }
      return h / ampSum;
    };
  }

  function ridgeHeights(
    cols: number,
    rows: number,
    bandMinFrac: number,
    bandMaxFrac: number,
    biome: Biome,
    extraAmpScale = 1
  ) {
    const wave = makeWaveFn(biome.waveCount, biome.ridged, biome.freqRange);
    const bandMin = Math.round(rows * bandMinFrac);
    const bandMax = Math.round(rows * bandMaxFrac);

    const heights = new Array(cols);
    for (let x = 0; x < cols; x++) {
      const h = wave(x / cols);
      let top: number;
      if (biome.ridged) {
        const amp = (bandMax - bandMin) * extraAmpScale;
        top = Math.round(bandMax - h * amp);
      } else {
        const mid = (bandMin + bandMax) / 2;
        const amp = ((bandMax - bandMin) / 2) * biome.ampScale * extraAmpScale;
        top = Math.round(mid - h * amp);
      }
      top = Math.max(0, Math.min(rows - 1, top));
      heights[x] = top;
    }
    return heights;
  }

  // bottomBound (optional, per-column) stops the fill where the next
  // nearer layer is going to start, instead of always filling all the
  // way to the bottom of the grid — each layer only ever paints the
  // slice of rows it actually keeps, not the parts every closer layer
  // is about to overwrite anyway (roughly a 4x reduction in cell
  // writes for a 4-layer scene).
  function paintRidge(
    grid: Cell[][],
    ridge: number[],
    cols: number,
    rows: number,
    layer: string,
    fillChars: string[],
    bottomBound?: number[]
  ) {
    for (let x = 0; x < cols; x++) {
      const top = ridge[x];
      const prev = x > 0 ? ridge[x - 1] : top;
      let edge = "_";
      if (top < prev) edge = "/";
      else if (top > prev) edge = "\\";

      const limit = bottomBound ? Math.min(rows, bottomBound[x]) : rows;
      for (let y = top; y < limit; y++) {
        grid[y][x] = { ch: y === top ? edge : pick(fillChars), layer };
      }
    }
  }

  function paintMidDetail(grid: Cell[][], ridge: number[], cols: number, biome: Biome) {
    const minGap = Math.max(4, Math.floor(cols / (biome.midDetailDensity * 90)));
    let lastX = -minGap;
    for (let x = 1; x < cols - 1; x++) {
      if (x - lastX < minGap) continue;
      if (Math.random() > biome.midDetailDensity) continue;
      const top = ridge[x];
      grid[top][x] = { ch: biome.midDetailChar, layer: "mid" };
      lastX = x;
    }
  }

  function paintSnowCaps(grid: Cell[][], ridge: number[], cols: number, rows: number) {
    const peak = Math.min(...ridge);
    const threshold = peak + 2;
    for (let x = 0; x < cols; x++) {
      if (ridge[x] > threshold) continue;
      const top = ridge[x];
      grid[top][x] = { ch: "^", layer: "snow" };
      if (top + 1 < rows) grid[top + 1][x] = { ch: "*", layer: "snow" };
    }
  }

  // Evenly spaced fence posts with a top rail — a quick, legible
  // "this is grazing rangeland" marker along the foreground band.
  function paintFence(grid: Cell[][], ridge: number[], cols: number) {
    if (Math.random() > 0.5) return;
    const postGap = Math.max(5, Math.floor(cols / rand(14, 22)));
    const startX = Math.floor(rand(2, postGap));
    let lastPostX: number | null = null;
    for (let x = startX; x < cols - 2; x += postGap) {
      const top = ridge[x];
      if (top - 2 < 0) continue;
      grid[top - 2][x] = { ch: "|", layer: "fence" };
      grid[top - 1][x] = { ch: "|", layer: "fence" };
      if (lastPostX !== null) {
        for (let rx = lastPostX + 1; rx < x; rx++) {
          const rTop = ridge[rx];
          if (rTop - 1 >= 0 && grid[rTop - 1][rx] === null) {
            grid[rTop - 1][rx] = { ch: "-", layer: "fence" };
          }
        }
      }
      lastPostX = x;
    }
  }

  // ===== Vegetation: several genuinely different species per biome
  // (not size variants of one silhouette), each a list of {dx, dy, ch}
  // offsets from the ground point (dy negative = upward), with mixed
  // texture characters rather than one uniform fill glyph so canopies/
  // bodies read as organic, not a solid block.
  const MATURE_PINE: VegShape = [
    { dx: 0, dy: -5, ch: "^" },
    { dx: -1, dy: -4, ch: "/" }, { dx: 0, dy: -4, ch: "'" }, { dx: 1, dy: -4, ch: "\\" },
    { dx: -2, dy: -3, ch: "/" }, { dx: -1, dy: -3, ch: "#" }, { dx: 0, dy: -3, ch: "^" }, { dx: 1, dy: -3, ch: "#" }, { dx: 2, dy: -3, ch: "\\" },
    { dx: -2, dy: -2, ch: "#" }, { dx: -1, dy: -2, ch: "'" }, { dx: 0, dy: -2, ch: "#" }, { dx: 1, dy: -2, ch: "'" }, { dx: 2, dy: -2, ch: "#" },
    { dx: -3, dy: -1, ch: "/" }, { dx: -2, dy: -1, ch: "#" }, { dx: -1, dy: -1, ch: "#" }, { dx: 0, dy: -1, ch: "#" }, { dx: 1, dy: -1, ch: "#" }, { dx: 2, dy: -1, ch: "#" }, { dx: 3, dy: -1, ch: "\\" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const YOUNG_PINE: VegShape = [
    { dx: 0, dy: -2, ch: "^" },
    { dx: -1, dy: -1, ch: "/" }, { dx: 0, dy: -1, ch: "#" }, { dx: 1, dy: -1, ch: "\\" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const WIND_PINE: VegShape = [
    { dx: 1, dy: -3, ch: "^" },
    { dx: 0, dy: -2, ch: "/" }, { dx: 1, dy: -2, ch: "#" }, { dx: 2, dy: -2, ch: "~" },
    { dx: -1, dy: -1, ch: "_" }, { dx: 0, dy: -1, ch: "#" }, { dx: 1, dy: -1, ch: "#" }, { dx: 2, dy: -1, ch: "#" }, { dx: 3, dy: -1, ch: "~" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const ASPEN: VegShape = [
    { dx: -1, dy: -3, ch: "o" }, { dx: 0, dy: -3, ch: "o" }, { dx: 1, dy: -3, ch: "o" },
    { dx: -2, dy: -2, ch: "o" }, { dx: -1, dy: -2, ch: "@" }, { dx: 0, dy: -2, ch: "@" }, { dx: 1, dy: -2, ch: "@" }, { dx: 2, dy: -2, ch: "o" },
    { dx: -1, dy: -1, ch: "@" }, { dx: 0, dy: -1, ch: "@" }, { dx: 1, dy: -1, ch: "@" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const DEAD_SNAG: VegShape = [
    { dx: 0, dy: -2, ch: "|" },
    { dx: 1, dy: -1, ch: "/" }, { dx: 0, dy: -1, ch: "|" }, { dx: -1, dy: -1, ch: "`" },
    { dx: 0, dy: 0, ch: "|" },
  ];

  const SAGE_MOUND: VegShape = [
    { dx: -1, dy: -2, ch: "*" }, { dx: 0, dy: -2, ch: "*" }, { dx: 1, dy: -2, ch: "*" },
    { dx: -2, dy: -1, ch: "o" }, { dx: -1, dy: -1, ch: "@" }, { dx: 0, dy: -1, ch: "'" }, { dx: 1, dy: -1, ch: "@" }, { dx: 2, dy: -1, ch: "o" },
    { dx: -1, dy: 0, ch: "'" }, { dx: 0, dy: 0, ch: "@" }, { dx: 1, dy: 0, ch: "'" },
  ];
  const RABBITBRUSH: VegShape = [
    { dx: 0, dy: -3, ch: "^" }, { dx: 1, dy: -3, ch: "'" },
    { dx: -1, dy: -2, ch: "|" }, { dx: 0, dy: -2, ch: "^" }, { dx: 1, dy: -2, ch: "|" }, { dx: 2, dy: -2, ch: "'" },
    { dx: -2, dy: -1, ch: "'" }, { dx: -1, dy: -1, ch: "|" }, { dx: 0, dy: -1, ch: "@" }, { dx: 1, dy: -1, ch: "|" }, { dx: 2, dy: -1, ch: "@" }, { dx: 3, dy: -1, ch: "'" },
    { dx: -1, dy: 0, ch: "@" }, { dx: 0, dy: 0, ch: "@" }, { dx: 1, dy: 0, ch: "@" },
  ];
  const BUNCHGRASS: VegShape = [
    { dx: -2, dy: -1, ch: "'" }, { dx: -1, dy: -1, ch: "|" }, { dx: 0, dy: -1, ch: "\"" }, { dx: 1, dy: -1, ch: "|" }, { dx: 2, dy: -1, ch: "'" },
    { dx: -1, dy: 0, ch: "," }, { dx: 0, dy: 0, ch: "," }, { dx: 1, dy: 0, ch: "," },
  ];
  const CREEPING_SHRUB: VegShape = [
    { dx: -3, dy: -1, ch: "'" }, { dx: -2, dy: -1, ch: "o" }, { dx: -1, dy: -1, ch: "@" }, { dx: 0, dy: -1, ch: "@" }, { dx: 1, dy: -1, ch: "@" }, { dx: 2, dy: -1, ch: "o" }, { dx: 3, dy: -1, ch: "'" },
    { dx: -2, dy: 0, ch: "," }, { dx: -1, dy: 0, ch: "," }, { dx: 0, dy: 0, ch: "," }, { dx: 1, dy: 0, ch: "," }, { dx: 2, dy: 0, ch: "," },
  ];
  const WILDFLOWER: VegShape = [
    { dx: 0, dy: -1, ch: "*" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const LOW_TUFT: VegShape = [
    { dx: -1, dy: 0, ch: "'" }, { dx: 0, dy: 0, ch: "\"" }, { dx: 1, dy: 0, ch: "'" },
  ];

  const SAGUARO: VegShape = [
    { dx: -1, dy: -2, ch: "\\" }, { dx: 0, dy: -2, ch: "|" }, { dx: 1, dy: -2, ch: "/" },
    { dx: 0, dy: -1, ch: "|" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const BIG_SAGUARO: VegShape = [
    { dx: 0, dy: -3, ch: "|" },
    { dx: -2, dy: -2, ch: "\\" }, { dx: -1, dy: -2, ch: "|" }, { dx: 0, dy: -2, ch: "|" }, { dx: 1, dy: -2, ch: "|" }, { dx: 2, dy: -2, ch: "/" },
    { dx: -2, dy: -1, ch: "|" }, { dx: 0, dy: -1, ch: "|" }, { dx: 2, dy: -1, ch: "|" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const OCOTILLO: VegShape = [
    { dx: -2, dy: -4, ch: "'" }, { dx: 2, dy: -4, ch: "'" },
    { dx: -2, dy: -3, ch: "|" }, { dx: -1, dy: -3, ch: "'" }, { dx: 1, dy: -3, ch: "'" }, { dx: 2, dy: -3, ch: "|" },
    { dx: -2, dy: -2, ch: "|" }, { dx: -1, dy: -2, ch: "|" }, { dx: 0, dy: -2, ch: "'" }, { dx: 1, dy: -2, ch: "|" }, { dx: 2, dy: -2, ch: "|" },
    { dx: -1, dy: -1, ch: "|" }, { dx: 0, dy: -1, ch: "|" }, { dx: 1, dy: -1, ch: "|" },
    { dx: 0, dy: 0, ch: "Y" },
  ];
  const CHOLLA: VegShape = [
    { dx: -1, dy: -2, ch: "o" }, { dx: 0, dy: -2, ch: "O" }, { dx: 1, dy: -2, ch: "o" },
    { dx: 0, dy: -1, ch: "8" },
    { dx: 0, dy: 0, ch: "|" },
  ];
  const BARREL_CACTUS: VegShape = [
    { dx: 0, dy: -1, ch: "O" },
    { dx: -1, dy: 0, ch: "(" }, { dx: 0, dy: 0, ch: "|" }, { dx: 1, dy: 0, ch: ")" },
  ];
  const PAD_CACTUS: VegShape = [
    { dx: -1, dy: -1, ch: "o" }, { dx: 0, dy: -1, ch: "O" }, { dx: 1, dy: -1, ch: "o" },
    { dx: -2, dy: 0, ch: "o" }, { dx: -1, dy: 0, ch: "O" }, { dx: 0, dy: 0, ch: "@" }, { dx: 1, dy: 0, ch: "O" }, { dx: 2, dy: 0, ch: "o" },
  ];
  const DESERT_SCRUB: VegShape = [
    { dx: -1, dy: -1, ch: "'" }, { dx: 0, dy: -1, ch: "*" }, { dx: 1, dy: -1, ch: "'" },
    { dx: 0, dy: 0, ch: "@" },
  ];

  const VEG_SHAPES: Record<Biome["veg"], VegShape[]> = {
    tree: [MATURE_PINE, MATURE_PINE, YOUNG_PINE, WIND_PINE, ASPEN, ASPEN, DEAD_SNAG],
    shrub: [SAGE_MOUND, SAGE_MOUND, RABBITBRUSH, BUNCHGRASS, BUNCHGRASS, CREEPING_SHRUB, WILDFLOWER, LOW_TUFT],
    cactus: [SAGUARO, SAGUARO, BIG_SAGUARO, OCOTILLO, CHOLLA, BARREL_CACTUS, PAD_CACTUS, DESERT_SCRUB],
  };

  function stampShape(grid: Cell[][], shape: VegShape, x: number, top: number, rows: number, cols: number, layer: string) {
    for (const cell of shape) {
      const gy = top + cell.dy;
      const gx = x + cell.dx;
      if (gy < 0 || gy >= rows) continue;
      if (gx < 1 || gx >= cols - 1) continue;
      grid[gy][gx] = { ch: cell.ch, layer };
    }
  }

  function paintVegetation(grid: Cell[][], ridge: number[], cols: number, rows: number, biome: Biome) {
    const shapes = VEG_SHAPES[biome.veg] || [];
    if (shapes.length === 0) return;

    const minGap = Math.max(9, Math.floor(cols / (biome.vegDensity * 36)));
    let lastX = -minGap;

    for (let x = 4; x < cols - 4; x++) {
      if (x - lastX < minGap) continue;
      if (Math.random() > biome.vegDensity) continue;

      const shape = pick(shapes);
      const top = ridge[x];
      const minDy = Math.min(...shape.map((c) => c.dy));
      if (top + minDy < 0) continue;

      stampShape(grid, shape, x, top, rows, cols, "veg");
      lastX = x;
    }

    if (biome.grazer && Math.random() < 0.6) {
      const x = Math.floor(rand(cols * 0.15, cols * 0.85));
      const top = ridge[x];
      grid[top][x] = { ch: "m", layer: "veg" };
    }
  }

  function paintSky(grid: Cell[][], cols: number, skyRows: number) {
    const starChars = [".", "*", "'", "`"];
    const starCount = Math.floor(cols * skyRows * 0.05);
    for (let i = 0; i < starCount; i++) {
      const x = Math.floor(rand(0, cols));
      const y = Math.floor(rand(0, skyRows));
      if (grid[y][x] === null) {
        grid[y][x] = { ch: pick(starChars), layer: "star" };
      }
    }
    const gx = Math.floor(rand(cols * 0.08, cols * 0.88));
    const gy = Math.floor(rand(0, skyRows * 0.5));
    if (skyRows > 0) grid[gy][gx] = { ch: "O", layer: "glow" };
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function render(grid: Cell[][], rows: number, cols: number) {
    let html = "";
    for (let y = 0; y < rows; y++) {
      const row = grid[y];
      let x = 0;
      while (x < cols) {
        const cell = row[x];
        if (cell === null) {
          html += " ";
          x++;
          continue;
        }
        const layer = cell.layer;
        let run = cell.ch;
        let j = x + 1;
        while (j < cols && row[j] !== null && row[j]!.layer === layer) {
          run += row[j]!.ch;
          j++;
        }
        html += `<span class="L-${layer}">${escapeHtml(run)}</span>`;
        x = j;
      }
      html += "\n";
    }
    return html;
  }

  function measureCharSize(pre: HTMLElement) {
    const probe = document.createElement("span");
    probe.textContent = "#".repeat(20);
    probe.style.visibility = "hidden";
    probe.style.position = "absolute";
    probe.style.whiteSpace = "pre";
    pre.appendChild(probe);
    const width = probe.getBoundingClientRect().width / 20;
    pre.removeChild(probe);
    return width;
  }

  function measureLineHeight(pre: HTMLElement) {
    const probe = document.createElement("span");
    probe.textContent = "#\n#\n#\n#\n#";
    probe.style.visibility = "hidden";
    probe.style.position = "absolute";
    probe.style.whiteSpace = "pre";
    pre.appendChild(probe);
    const height = probe.getBoundingClientRect().height / 5;
    pre.removeChild(probe);
    return height;
  }

  // ===== Weather / wildlife =====
  let weatherTimer: ReturnType<typeof setTimeout> | null = null;
  const activeIntervals: ReturnType<typeof setInterval>[] = [];

  function clearWeather(layer: HTMLElement | null) {
    if (weatherTimer) {
      clearTimeout(weatherTimer);
      weatherTimer = null;
    }
    for (const t of activeIntervals) clearInterval(t);
    activeIntervals.length = 0;
    if (layer) layer.innerHTML = "";
  }

  // Small flapping birds get a real 3-frame wingbeat; occasionally a
  // bigger, slower soaring bird glides through instead — same size,
  // just a plain "V" held fixed with no flap, for variety in the sky.
  function spawnBirds(layer: HTMLElement, skyMaxPct: number) {
    const soaring = Math.random() < 0.3;
    const count = soaring ? 1 : Math.random() < 0.4 ? 2 : 1;

    for (let i = 0; i < count; i++) {
      const bird = document.createElement("span");
      bird.className = "wx-bird" + (soaring ? " wx-bird-soar" : "");
      bird.style.top = rand(2, skyMaxPct) + "%";
      bird.style.animationDuration = (soaring ? rand(16, 24) : rand(9, 15)) + "s";
      bird.style.animationDelay = rand(0, 2) + "s";
      layer.appendChild(bird);

      if (soaring) {
        bird.textContent = "V";
        bird.addEventListener("animationend", () => bird.remove());
      } else {
        const frames = ["v", "-", "^", "-"];
        let fi = 0;
        bird.textContent = frames[0];
        const flap = setInterval(() => {
          fi = (fi + 1) % frames.length;
          bird.textContent = frames[fi];
        }, 180);
        activeIntervals.push(flap);
        bird.addEventListener("animationend", () => {
          clearInterval(flap);
          bird.remove();
        });
      }
    }
  }

  function spawnCloud(layer: HTMLElement, skyMaxPct: number) {
    const shapes = ["~~~~", ".~~~~.", "~~~~~~", ".~~~~~~.", "~~~~~~~~~"];
    const cloud = document.createElement("span");
    cloud.className = "wx-cloud";
    cloud.textContent = pick(shapes);
    cloud.style.top = rand(2, Math.max(4, skyMaxPct * 0.75)) + "%";
    cloud.style.animationDuration = rand(28, 50) + "s";
    cloud.style.setProperty("--bob", rand(-3, 3).toFixed(1) + "%");
    layer.appendChild(cloud);
    cloud.addEventListener("animationend", () => cloud.remove());
  }

  // Persistent for the whole visit — no cleanup timer. Cleared only
  // when clearWeather() wipes the layer on the next regenerate.
  function spawnPersistentPrecip(layer: HTMLElement, kind: "snow" | "rain") {
    const count = kind === "snow" ? 16 : 22;
    const chars = kind === "snow" ? ["*", ".", "'"] : ["|", "'", ","];
    const fallDur = kind === "snow" ? rand(3, 4.5) : rand(1, 1.6);
    for (let i = 0; i < count; i++) {
      const p = document.createElement("span");
      p.className = `wx-particle wx-${kind}`;
      p.textContent = pick(chars);
      p.style.left = rand(0, 100) + "%";
      p.style.animationDuration = fallDur + "s";
      p.style.animationDelay = -rand(0, fallDur) + "s";
      p.style.animationIterationCount = "infinite";
      layer.appendChild(p);
    }
  }

  // Leaves combine a smooth CSS-driven drift/wobble (wx-blow) with a
  // small flutter — alternating between two related glyphs — so each
  // leaf visibly turns as it blows through, not just slides.
  function spawnLeaves(layer: HTMLElement) {
    const count = Math.random() < 0.5 ? 3 : 2;
    const glyphSets = [
      [",", "'"],
      ['"', ";"],
      [",", '"'],
    ];
    for (let i = 0; i < count; i++) {
      const leaf = document.createElement("span");
      leaf.className = "wx-leaf";
      const glyphs = pick(glyphSets);
      leaf.textContent = glyphs[0];
      leaf.style.top = rand(50, 78) + "%";
      leaf.style.animationDuration = rand(3.5, 5.5) + "s";
      leaf.style.animationDelay = rand(0, 2.2) + "s";
      layer.appendChild(leaf);

      let gi = 0;
      const flutter = setInterval(() => {
        gi = (gi + 1) % glyphs.length;
        leaf.textContent = glyphs[gi];
      }, 160);
      activeIntervals.push(flutter);

      leaf.addEventListener("animationend", () => {
        clearInterval(flutter);
        leaf.remove();
      });
    }
  }

  // Recurring rather than one-shot: rechecks every so often for as
  // long as the page stays open. Cancelled and restarted by
  // clearWeather() on every regenerate (resize) via the shared
  // weatherTimer handle. Only covers birds/leaves/cloud — precipitation
  // is decided once in generate(), not here.
  function scheduleNextWeather(
    layer: HTMLElement,
    biome: Biome,
    cols: number,
    rows: number,
    skyMaxPct: number
  ) {
    const delay = rand(4500, 11000);
    weatherTimer = setTimeout(() => {
      if (Math.random() < 0.65 && biome.weather.length > 0) {
        const kind = pick(biome.weather);
        if (kind === "birds") spawnBirds(layer, skyMaxPct);
        else if (kind === "cloud") spawnCloud(layer, skyMaxPct);
        else if (kind === "leaves") spawnLeaves(layer);
      }
      scheduleNextWeather(layer, biome, cols, rows, skyMaxPct);
    }, delay);
  }

  function generate() {
    const wrap = document.getElementById("ascii-landscape");
    const pre = document.getElementById("ascii-landscape-art");
    const weatherLayer = document.getElementById("ascii-landscape-weather");
    const groundSpace = document.getElementById("ground-space");
    if (!wrap || !pre) return;

    clearWeather(weatherLayer);

    const biome = pick(BIOMES);
    wrap.dataset.biome = biome.name;

    const charWidth = measureCharSize(pre);
    const lineHeight = measureLineHeight(pre);
    if (!charWidth || !lineHeight) return;

    const cols = Math.max(90, Math.min(420, Math.floor(wrap.clientWidth / charWidth)));

    const totalHeightPx = wrap.clientHeight;
    const groundHeightPx = groundSpace ? groundSpace.offsetHeight : totalHeightPx * 0.35;
    const rows = Math.max(70, Math.min(260, Math.round(totalHeightPx / lineHeight)));

    // fraction of the scene's total height taken up by real page
    // content (everything above the reserved ground space) — terrain
    // bands are placed relative to this so the dense "fore" band
    // reliably lands inside the reserved ground space at the bottom.
    const contentFrac = Math.max(0.15, Math.min(0.92, 1 - groundHeightPx / totalHeightPx));

    const grid: Cell[][] = Array.from({ length: rows }, () => new Array(cols).fill(null));

    // Stars (and the glow marker standing in for them) are a night-sky
    // detail — skip them in light mode instead of scattering dots and
    // a stray glowing "O" across a plain daytime sky.
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    const skyMaxFrac = contentFrac * 0.55;
    if (isDark) paintSky(grid, cols, Math.round(rows * skyMaxFrac));

    // Compute every ridge line up front so each layer's fill can stop
    // exactly where the next, nearer layer begins (see paintRidge).
    const far = ridgeHeights(cols, rows, contentFrac * 0.3, contentFrac * 0.82, biome, biome.farMidFlatten);
    const midMax = contentFrac + (1 - contentFrac) * 0.42;
    const mid = ridgeHeights(cols, rows, contentFrac * 0.66, midMax, biome, biome.farMidFlatten);
    const nearMin = contentFrac + (1 - contentFrac) * 0.16;
    const nearMax = contentFrac + (1 - contentFrac) * 0.62;
    const near = ridgeHeights(cols, rows, nearMin, nearMax, biome, 1);
    const foreMin = contentFrac + (1 - contentFrac) * 0.48;
    const fore = ridgeHeights(cols, rows, foreMin, 0.995, biome, 1);

    paintRidge(grid, far, cols, rows, "far", biome.farFill, mid);
    paintRidge(grid, mid, cols, rows, "mid", biome.midFill, near);
    paintMidDetail(grid, mid, cols, biome);
    paintRidge(grid, near, cols, rows, "near", ["#"], fore);
    if (biome.snowCaps) paintSnowCaps(grid, near, cols, rows);
    paintRidge(grid, fore, cols, rows, "fore", biome.foreFill);
    if (biome.fence) paintFence(grid, fore, cols);
    paintVegetation(grid, fore, cols, rows, biome);

    pre.innerHTML = render(grid, rows, cols);

    const reducedMotion =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (weatherLayer && !reducedMotion) {
      if (biome.precip && Math.random() < 0.2) {
        spawnPersistentPrecip(weatherLayer, biome.precip);
      }
      scheduleNextWeather(weatherLayer, biome, cols, rows, skyMaxFrac * 100);
    }
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(generate, 250);
  });

  // Defer the first generation by a frame so real page content paints
  // immediately instead of the whole page blocking on building and
  // inserting a large grid before anything is visible at all.
  requestAnimationFrame(() => requestAnimationFrame(generate));
</script>

<style>
  .ascii-landscape {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ascii-landscape-art {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: clamp(6px, 0.82vw, 11px);
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    text-align: center;
    user-select: none;
    font-weight: 600;
  }

  .ascii-landscape-art :global(.L-star) { color: var(--ink-2); opacity: 0.7; animation: wx-twinkle 4.5s ease-in-out infinite; }
  .ascii-landscape-art :global(.L-glow) { color: var(--contour); font-weight: 800; }
  .ascii-landscape-art :global(.L-far) { color: var(--land-far); animation: wx-shimmer-far 7s ease-in-out infinite; }
  .ascii-landscape-art :global(.L-mid) { color: var(--land-mid); animation: wx-shimmer-mid 9s ease-in-out infinite; }
  .ascii-landscape-art :global(.L-near) { color: var(--land-near); }
  .ascii-landscape-art :global(.L-fore) { color: var(--land-fore); }
  .ascii-landscape-art :global(.L-veg) { color: var(--land-veg); }
  .ascii-landscape-art :global(.L-snow) { color: var(--land-snow); }
  .ascii-landscape-art :global(.L-fence) { color: var(--land-fence); }

  @keyframes wx-twinkle { 0%, 100% { opacity: 0.85; } 50% { opacity: 0.25; } }

  /* ===== Biome palettes — glyph color only, no background fill. Real
     hue separation per layer (not just a lightness step on one hue),
     and veg is always a distinctly more saturated green than the
     terrain around it. Light mode: far lightest / fore darkest
     (daytime haze). Dark mode: far darkest / fore lightest (things
     nearer catch more of what light there is). ===== */
  .ascii-landscape[data-biome="pine"] {
    --land-far: #a8b49c; --land-mid: #5f8a6e; --land-near: #2c5a44; --land-fore: #24401f;
    --land-veg: #1a7a42; --land-snow: #ffffff; --land-fence: #6b5738;
  }
  .ascii-landscape[data-biome="desert"] {
    --land-far: #c9a688; --land-mid: #b8823f; --land-near: #8a5a2e; --land-fore: #5c3a18;
    --land-veg: #4a7a2e; --land-snow: transparent; --land-fence: #7a5230;
  }
  .ascii-landscape[data-biome="steppe"] {
    --land-far: #aba48c; --land-mid: #a68a4a; --land-near: #6b4f2a; --land-fore: #453518;
    --land-veg: #4a7a2e; --land-snow: transparent; --land-fence: #6b5738;
  }
  /* No bare @media (prefers-color-scheme: dark) fallback here —
     theme-toggle.js always sets data-theme explicitly (from
     localStorage or the OS preference) before this component's own
     script populates anything, so relying only on the data-theme
     attribute (rather than also matching on the OS media query)
     avoids a real bug: a media-query rule would keep re-asserting
     dark colors on top of an explicit data-theme="light" choice
     whenever the OS itself still prefers dark. */
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="pine"] {
    --land-far: #3d4d56; --land-mid: #2f5c48; --land-near: #3a6b4a; --land-fore: #6a9c6a;
    --land-veg: #22a35c; --land-snow: #e8f0ee; --land-fence: #8a7550;
  }
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="desert"] {
    --land-far: #6b5040; --land-mid: #8a5c2c; --land-near: #a67a3a; --land-fore: #d9ab5e;
    --land-veg: #6ba33e; --land-snow: transparent; --land-fence: #a08152;
  }
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="steppe"] {
    --land-far: #454f5e; --land-mid: #665840; --land-near: #8a7248; --land-fore: #c2a262;
    --land-veg: #7ba34e; --land-snow: transparent; --land-fence: #a68a5c;
  }

  /* ===== Weather / wildlife overlay ===== */
  .ascii-landscape-weather {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.7vw, 19px);
  }

  .ascii-landscape-weather :global(.wx-bird) {
    position: absolute; left: -6%; color: var(--ink);
    animation-name: wx-fly; animation-timing-function: linear; animation-fill-mode: forwards;
  }
  .ascii-landscape-weather :global(.wx-bird-soar) { opacity: 0.85; }

  .ascii-landscape-weather :global(.wx-cloud) {
    position: absolute; left: -10%; color: var(--ink-2); opacity: 0.55;
    animation-name: wx-drift; animation-timing-function: linear; animation-fill-mode: forwards;
  }

  .ascii-landscape-weather :global(.wx-particle) { position: absolute; top: -6%; animation-name: wx-fall; animation-timing-function: linear; }
  .ascii-landscape-weather :global(.wx-snow) { color: var(--ink-2); }
  .ascii-landscape-weather :global(.wx-rain) { color: var(--ink-2); }

  .ascii-landscape-weather :global(.wx-leaf) {
    position: absolute;
    left: -6%;
    color: var(--wood);
    animation-name: wx-blow;
    animation-timing-function: ease-in-out;
    animation-fill-mode: forwards;
  }

  @keyframes wx-fly {
    0%   { left: -6%;  transform: translateY(0); }
    25%  { transform: translateY(-6%); }
    50%  { transform: translateY(2%); }
    75%  { transform: translateY(-4%); }
    100% { left: 106%; transform: translateY(0); }
  }
  @keyframes wx-drift {
    0%   { left: -10%; transform: translateY(0); }
    50%  { transform: translateY(var(--bob, 2%)); }
    100% { left: 110%; transform: translateY(0); }
  }
  @keyframes wx-fall { 0% { top: -6%; opacity: 1; } 100% { top: 106%; opacity: 0.85; } }
  @keyframes wx-shimmer-far { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
  @keyframes wx-shimmer-mid { 0%, 100% { opacity: 1; } 50% { opacity: 0.75; } }
  @keyframes wx-blow {
    0%   { left: -6%;  transform: translateY(0) rotate(0deg); opacity: 0; }
    8%   { opacity: 1; }
    30%  { transform: translateY(-10%) rotate(60deg); }
    55%  { transform: translateY(6%) rotate(160deg); }
    78%  { transform: translateY(-6%) rotate(260deg); }
    92%  { opacity: 1; }
    100% { left: 106%; transform: translateY(4%) rotate(360deg); opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-landscape-art :global(.L-star),
    .ascii-landscape-art :global(.L-far),
    .ascii-landscape-art :global(.L-mid),
    .ascii-landscape-weather :global(.wx-bird),
    .ascii-landscape-weather :global(.wx-cloud),
    .ascii-landscape-weather :global(.wx-particle),
    .ascii-landscape-weather :global(.wx-leaf) {
      animation: none;
    }
  }
</style>
