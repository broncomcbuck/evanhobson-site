---
// Procedurally generated ASCII landscape, regenerated on every load/resize.
// Picks a random biome (pine / desert / steppe) each time, each with its
// own terrain-shape math, vegetation, and CSS palette (data-biome attr).
// Single merged character grid so nearer ridges properly occlude farther
// ones (no overlapping/garbled glyphs from independently stacked layers).
// No background — only the glyphs themselves carry color, the page's own
// background shows through everywhere else.
---

<div class="ascii-landscape" id="ascii-landscape" aria-hidden="true">
  <pre class="ascii-landscape-art" id="ascii-landscape-art"></pre>
  <div class="ascii-landscape-weather" id="ascii-landscape-weather"></div>
</div>

<script>
  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min;
  }

  function pick<T>(arr: T[]): T {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  type Cell = { ch: string; layer: string } | null;

  type WeatherKind = "birds" | "tumbleweed";

  type Biome = {
    name: string;
    ridged: boolean;
    waveCount: number;
    freqRange: [number, number];
    ampScale: number;
    // extra amplitude multiplier applied only to the far/mid layers, on
    // top of ampScale — lets a biome (desert) have a flatter horizon
    // without flattening its own foreground dunes
    farMidFlatten: number;
    // weighted fill-character sets for the two background layers (mostly
    // the first character, occasional variety mixed in for texture
    // instead of a flat solid block)
    farFill: string[];
    midFill: string[];
    // sparse single-glyph accents scattered along the mid ridge line
    midDetailChar: string;
    midDetailDensity: number;
    veg: "tree" | "cactus" | "shrub";
    vegDensity: number;
    snowCaps: boolean;
    grazer: boolean;
    // recurring transient events (birds flying through, a tumbleweed
    // rolling past) — these keep re-rolling for as long as the page
    // is open
    weather: WeatherKind[];
    // persistent whole-scene precipitation — decided ONCE per page
    // load/reload; if it's on, it stays on for the whole visit, no
    // in-between fading in and out
    precip: "snow" | "rain" | null;
  };

  const BIOMES: Biome[] = [
    {
      name: "pine",
      ridged: true,
      waveCount: 3,
      freqRange: [0.9, 2.6],
      ampScale: 1,
      farMidFlatten: 1,
      farFill: [".", ".", ".", "'"],
      midFill: [":", ":", ":", "-"],
      midDetailChar: "^",
      midDetailDensity: 0.06,
      veg: "tree",
      vegDensity: 0.17,
      snowCaps: true,
      grazer: false,
      weather: ["birds"],
      precip: "snow",
    },
    {
      name: "desert",
      ridged: false,
      waveCount: 2,
      freqRange: [0.4, 1.1],
      ampScale: 0.85,
      farMidFlatten: 0.45,
      farFill: ["~", "~", "~", "."],
      midFill: ["~", "~", "~", ":"],
      midDetailChar: "o",
      midDetailDensity: 0.05,
      veg: "cactus",
      vegDensity: 0.07,
      snowCaps: false,
      grazer: false,
      weather: ["birds", "tumbleweed"],
      precip: null,
    },
    {
      name: "steppe",
      ridged: false,
      waveCount: 2,
      freqRange: [0.5, 1.2],
      ampScale: 0.55,
      farMidFlatten: 1,
      farFill: [".", ".", ".", "'"],
      midFill: [":", ":", ":", "-"],
      midDetailChar: "'",
      midDetailDensity: 0.07,
      veg: "shrub",
      vegDensity: 0.22,
      snowCaps: false,
      grazer: true,
      weather: ["birds"],
      precip: "rain",
    },
  ];

  // Sum of a few sine waves. Plain sine sum -> smooth rolling terrain.
  // "Ridged" sum (1 - |sin|) per octave -> sharp cusped peaks over flatter
  // valleys, the standard trick for jagged mountain-like silhouettes.
  function makeWaveFn(waveCount: number, ridged: boolean, freqRange: [number, number]) {
    const waves = [];
    for (let i = 0; i < waveCount; i++) {
      waves.push({
        freq: rand(freqRange[0], freqRange[1]) * (i + 1),
        amp: rand(0.4, 1) / (i + 1),
        phase: rand(0, Math.PI * 2),
      });
    }
    const ampSum = waves.reduce((s, w) => s + w.amp, 0);
    return (t: number) => {
      let h = 0;
      for (const w of waves) {
        let v = Math.sin(t * Math.PI * 2 * w.freq + w.phase);
        if (ridged) v = 1 - Math.abs(v);
        h += v * w.amp;
      }
      return h / ampSum;
    };
  }

  function ridgeHeights(
    cols: number,
    rows: number,
    bandMinFrac: number,
    bandMaxFrac: number,
    biome: Biome,
    extraAmpScale = 1
  ) {
    const wave = makeWaveFn(biome.waveCount, biome.ridged, biome.freqRange);
    const bandMin = Math.round(rows * bandMinFrac);
    const bandMax = Math.round(rows * bandMaxFrac);

    const heights = new Array(cols);
    for (let x = 0; x < cols; x++) {
      const h = wave(x / cols);
      let top: number;
      if (biome.ridged) {
        // h in [0,1]: 0 = valley (bandMax), 1 = sharp peak (bandMin)
        const amp = (bandMax - bandMin) * extraAmpScale;
        top = Math.round(bandMax - h * amp);
      } else {
        // h in ~[-1,1]: symmetric displacement around the band midpoint
        const mid = (bandMin + bandMax) / 2;
        const amp = ((bandMax - bandMin) / 2) * biome.ampScale * extraAmpScale;
        top = Math.round(mid - h * amp);
      }
      top = Math.max(0, Math.min(rows - 1, top));
      heights[x] = top;
    }
    return heights;
  }

  // fillChars is a weighted set (repeat a character to make it more
  // common) rather than one flat character — gives the fill a bit of
  // dithered texture instead of a solid uniform block.
  function paintRidge(
    grid: Cell[][],
    ridge: number[],
    cols: number,
    rows: number,
    layer: string,
    fillChars: string[]
  ) {
    for (let x = 0; x < cols; x++) {
      const top = ridge[x];
      const prev = x > 0 ? ridge[x - 1] : top;
      let edge = "_";
      if (top < prev) edge = "/";
      else if (top > prev) edge = "\\";

      for (let y = top; y < rows; y++) {
        grid[y][x] = { ch: y === top ? edge : pick(fillChars), layer };
      }
    }
  }

  // Sparse single-glyph accents along the mid ridge — a receding
  // treeline/rockline/grass-tuft suggestion, kept in the mid layer's own
  // color so the far < mid < near depth ordering stays unambiguous.
  function paintMidDetail(grid: Cell[][], ridge: number[], cols: number, biome: Biome) {
    const minGap = Math.max(4, Math.floor(cols / (biome.midDetailDensity * 90)));
    let lastX = -minGap;
    for (let x = 1; x < cols - 1; x++) {
      if (x - lastX < minGap) continue;
      if (Math.random() > biome.midDetailDensity) continue;
      const top = ridge[x];
      grid[top][x] = { ch: biome.midDetailChar, layer: "mid" };
      lastX = x;
    }
  }

  function paintSnowCaps(grid: Cell[][], ridge: number[], cols: number, rows: number) {
    const peak = Math.min(...ridge);
    const threshold = peak + 2;
    for (let x = 0; x < cols; x++) {
      if (ridge[x] > threshold) continue;
      const top = ridge[x];
      grid[top][x] = { ch: "^", layer: "snow" };
      if (top + 1 < rows) grid[top + 1][x] = { ch: "*", layer: "snow" };
    }
  }

  // Multi-row vegetation glyphs, one style per biome. Painted after (and so
  // on top of) the ridge, overwriting its edge/fill chars at those cells.
  function paintVegetation(
    grid: Cell[][],
    ridge: number[],
    cols: number,
    biome: Biome
  ) {
    const minGap = Math.max(6, Math.floor(cols / (biome.vegDensity * 60)));
    let lastX = -minGap;

    for (let x = 3; x < cols - 3; x++) {
      if (x - lastX < minGap) continue;
      if (Math.random() > biome.vegDensity) continue;

      const top = ridge[x];

      if (biome.veg === "shrub") {
        // low, bushy tuft
        if (top - 1 >= 0) grid[top - 1][x] = { ch: "*", layer: "veg" };
        grid[top][x - 1] = { ch: "o", layer: "veg" };
        grid[top][x] = { ch: "@", layer: "veg" };
        grid[top][x + 1] = { ch: "o", layer: "veg" };
        lastX = x;
        continue;
      }

      if (top - 2 < 0) continue;

      if (biome.veg === "cactus") {
        // saguaro: arms curving UP and outward from the trunk (not
        // drooping down like palm fronds — "\" and "/" are swapped
        // from what you'd first guess, since "\" rises toward its
        // outer/left end and "/" rises toward its outer/right end)
        grid[top - 2][x - 1] = { ch: "\\", layer: "veg" };
        grid[top - 2][x] = { ch: "|", layer: "veg" };
        grid[top - 2][x + 1] = { ch: "/", layer: "veg" };
        grid[top - 1][x] = { ch: "|", layer: "veg" };
        grid[top][x] = { ch: "|", layer: "veg" };
        lastX = x;
        continue;
      }

      // "tree" (pine): tiered triangular canopy over a trunk
      grid[top - 2][x] = { ch: "^", layer: "veg" };
      grid[top - 1][x - 1] = { ch: "/", layer: "veg" };
      grid[top - 1][x] = { ch: "_", layer: "veg" };
      grid[top - 1][x + 1] = { ch: "\\", layer: "veg" };
      grid[top][x] = { ch: "|", layer: "veg" };
      lastX = x;
    }

    // steppe-only easter egg: a single tiny grazing-animal silhouette
    if (biome.grazer && Math.random() < 0.6) {
      const x = Math.floor(rand(cols * 0.15, cols * 0.85));
      const top = ridge[x];
      grid[top][x] = { ch: "m", layer: "veg" };
    }
  }

  function paintSky(grid: Cell[][], cols: number, skyRows: number) {
    const starChars = [".", "*", "'", "`"];
    const starCount = Math.floor(cols * skyRows * 0.045);
    for (let i = 0; i < starCount; i++) {
      const x = Math.floor(rand(0, cols));
      const y = Math.floor(rand(0, skyRows));
      if (grid[y][x] === null) {
        grid[y][x] = { ch: pick(starChars), layer: "star" };
      }
    }
    const gx = Math.floor(rand(cols * 0.08, cols * 0.88));
    const gy = Math.floor(rand(0, skyRows * 0.5));
    grid[gy][gx] = { ch: "O", layer: "glow" };
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function render(grid: Cell[][], rows: number, cols: number) {
    let html = "";
    for (let y = 0; y < rows; y++) {
      const row = grid[y];
      let x = 0;
      while (x < cols) {
        const cell = row[x];
        if (cell === null) {
          html += " ";
          x++;
          continue;
        }
        const layer = cell.layer;
        let run = cell.ch;
        let j = x + 1;
        while (j < cols && row[j] !== null && row[j]!.layer === layer) {
          run += row[j]!.ch;
          j++;
        }
        html += `<span class="L-${layer}">${escapeHtml(run)}</span>`;
        x = j;
      }
      html += "\n";
    }
    return html;
  }

  function measureCharSize(pre: HTMLElement) {
    const probe = document.createElement("span");
    probe.textContent = "#".repeat(20);
    probe.style.visibility = "hidden";
    probe.style.position = "absolute";
    probe.style.whiteSpace = "pre";
    pre.appendChild(probe);
    const width = probe.getBoundingClientRect().width / 20;
    pre.removeChild(probe);
    return width;
  }

  // ===== Weather / wildlife =====
  // Two different kinds of "occasional": persistent precipitation is a
  // once-per-load coin flip that, if it lands, stays for the whole visit
  // (a scene property, not an event). Birds/tumbleweed are recurring
  // transient events that keep re-rolling while the page stays open.

  let weatherTimer: ReturnType<typeof setTimeout> | null = null;
  const activeIntervals: ReturnType<typeof setInterval>[] = [];

  function clearWeather(layer: HTMLElement | null) {
    if (weatherTimer) {
      clearTimeout(weatherTimer);
      weatherTimer = null;
    }
    for (const t of activeIntervals) clearInterval(t);
    activeIntervals.length = 0;
    if (layer) layer.innerHTML = "";
  }

  function spawnBirds(layer: HTMLElement) {
    const count = Math.random() < 0.4 ? 2 : 1;
    for (let i = 0; i < count; i++) {
      const bird = document.createElement("span");
      bird.className = "wx-bird";
      bird.textContent = "v";
      bird.style.top = rand(8, 30) + "%";
      bird.style.animationDuration = rand(7, 12) + "s";
      bird.style.animationDelay = rand(0, 2) + "s";
      layer.appendChild(bird);

      const flap = setInterval(() => {
        bird.textContent = bird.textContent === "v" ? "^" : "v";
      }, 220);
      activeIntervals.push(flap);

      bird.addEventListener("animationend", () => {
        clearInterval(flap);
        bird.remove();
      });
    }
  }

  // Persistent for the whole visit — no cleanup timer. Cleared only when
  // clearWeather() wipes the layer on the next regenerate (resize/reload).
  function spawnPersistentPrecip(layer: HTMLElement, kind: "snow" | "rain") {
    const count = kind === "snow" ? 16 : 22;
    const chars = kind === "snow" ? ["*", ".", "'"] : ["|", "'", ","];
    const fallDur = kind === "snow" ? rand(3, 4.5) : rand(1, 1.6);
    for (let i = 0; i < count; i++) {
      const p = document.createElement("span");
      p.className = `wx-particle wx-${kind}`;
      p.textContent = pick(chars);
      p.style.left = rand(0, 100) + "%";
      p.style.animationDuration = fallDur + "s";
      p.style.animationDelay = -rand(0, fallDur) + "s";
      p.style.animationIterationCount = "infinite";
      layer.appendChild(p);
    }
  }

  // Deliberately NOT smooth interpolation — a setInterval hop from
  // waypoint to waypoint (position snaps, no easing) plus a cycling
  // glyph (rotating a near-symmetric "o" via CSS transform barely
  // reads as motion at all) for a chunky, low-frame-rate sprite feel.
  // Vertical position at each hop is sampled from the actual near-ridge
  // heights so it still rolls along the ground contour.
  function spawnTumbleweed(layer: HTMLElement, nearRidge: number[], cols: number, rows: number) {
    const t = document.createElement("span");
    t.className = "wx-tumbleweed";
    layer.appendChild(t);

    const frames = ["*", "x", "+", "o"];
    const totalSteps = rand(14, 20);
    const stepMs = rand(280, 420);
    let step = 0;

    const tick = () => {
      const frac = step / totalSteps;
      const x = Math.max(0, Math.min(cols - 1, Math.floor(frac * cols)));
      const topPct = ((nearRidge[x] - 1) / rows) * 100;
      const leftPct = -6 + frac * 112;
      t.style.left = leftPct + "%";
      t.style.top = topPct + "%";
      t.textContent = frames[step % frames.length];
      step++;
      if (step > totalSteps) {
        clearInterval(hop);
        t.remove();
      }
    };

    tick();
    const hop = setInterval(tick, stepMs);
    activeIntervals.push(hop);
  }

  // Recurring rather than one-shot: rechecks every so often for as long
  // as the page stays open. Cancelled and restarted by clearWeather()
  // on every regenerate (resize) via the shared weatherTimer handle.
  // Only covers birds/tumbleweed — precipitation is decided once in
  // generate(), not here.
  function scheduleNextWeather(
    layer: HTMLElement,
    biome: Biome,
    near: number[],
    cols: number,
    rows: number
  ) {
    const delay = rand(6000, 14000);
    weatherTimer = setTimeout(() => {
      if (Math.random() < 0.55 && biome.weather.length > 0) {
        const kind = pick(biome.weather);
        if (kind === "birds") spawnBirds(layer);
        else spawnTumbleweed(layer, near, cols, rows);
      }
      scheduleNextWeather(layer, biome, near, cols, rows);
    }, delay);
  }

  function generate() {
    const wrap = document.getElementById("ascii-landscape");
    const pre = document.getElementById("ascii-landscape-art");
    const weatherLayer = document.getElementById("ascii-landscape-weather");
    if (!wrap || !pre) return;

    clearWeather(weatherLayer);

    const biome = pick(BIOMES);
    wrap.dataset.biome = biome.name;

    const rows = 40;
    const charWidth = measureCharSize(pre);
    if (!charWidth) return;

    const cols = Math.max(
      60,
      Math.min(340, Math.floor(wrap.clientWidth / charWidth))
    );

    const grid: Cell[][] = Array.from({ length: rows }, () =>
      new Array(cols).fill(null)
    );

    paintSky(grid, cols, Math.round(rows * 0.4));

    const far = ridgeHeights(cols, rows, 0.26, 0.46, biome, biome.farMidFlatten);
    paintRidge(grid, far, cols, rows, "far", biome.farFill);

    const mid = ridgeHeights(cols, rows, 0.48, 0.7, biome, biome.farMidFlatten);
    paintRidge(grid, mid, cols, rows, "mid", biome.midFill);
    paintMidDetail(grid, mid, cols, biome);

    const near = ridgeHeights(cols, rows, 0.7, 0.97, biome);
    paintRidge(grid, near, cols, rows, "near", ["#"]);
    if (biome.snowCaps) paintSnowCaps(grid, near, cols, rows);
    paintVegetation(grid, near, cols, biome);

    pre.innerHTML = render(grid, rows, cols);

    if (weatherLayer) {
      // Persistent precipitation: decided once per load, stays for the
      // whole visit if it lands — not part of the recurring cycle.
      if (biome.precip && Math.random() < 0.2) {
        spawnPersistentPrecip(weatherLayer, biome.precip);
      }
      scheduleNextWeather(weatherLayer, biome, near, cols, rows);
    }
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(generate, 200);
  });

  generate();
</script>

<style>
  .ascii-landscape {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    overflow: hidden;
  }

  .ascii-landscape-art {
    position: relative;
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: clamp(6px, 0.95vw, 10.5px);
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    text-align: center;
    user-select: none;
    font-weight: 600;
  }

  .ascii-landscape-art :global(.L-far) {
    color: var(--land-far);
    animation: wx-shimmer-far 7s ease-in-out infinite;
  }
  .ascii-landscape-art :global(.L-mid) {
    color: var(--land-mid);
    animation: wx-shimmer-mid 9s ease-in-out infinite;
  }
  .ascii-landscape-art :global(.L-near) { color: var(--land-near); }
  .ascii-landscape-art :global(.L-veg) { color: var(--land-veg); }
  .ascii-landscape-art :global(.L-snow) { color: var(--land-snow); }
  .ascii-landscape-art :global(.L-star) { color: var(--land-star); }
  .ascii-landscape-art :global(.L-glow) { color: var(--land-glow); font-weight: 800; }

  /* ===== Biome palettes — no background, glyph color only ===== */
  .ascii-landscape[data-biome="pine"] {
    --land-far: #a9c2b3;
    --land-mid: #6f9a80;
    --land-near: #2c5a44;
    --land-veg: #1c3f2f;
    --land-snow: #ffffff;
    --land-star: transparent;
    --land-glow: #f5c463;
  }
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="pine"] {
    --land-far: #2f4d47;
    --land-mid: #295c50;
    --land-near: #143a30;
    --land-veg: #0d241d;
    --land-snow: #dfeaec;
    --land-star: #b9c6d6;
    --land-glow: #eef2f7;
  }

  .ascii-landscape[data-biome="desert"] {
    --land-far: #e3c093;
    --land-mid: #cf9c5c;
    --land-near: #8a5a2e;
    --land-veg: #4f6b3a;
    --land-snow: transparent;
    --land-star: transparent;
    --land-glow: #ff9d4d;
  }
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="desert"] {
    --land-far: #5a4230;
    --land-mid: #493019;
    --land-near: #2c1c0d;
    --land-veg: #38492a;
    --land-snow: transparent;
    --land-star: #e0c9a6;
    --land-glow: #f2e3c8;
  }

  .ascii-landscape[data-biome="steppe"] {
    --land-far: #c7c79c;
    --land-mid: #a3a375;
    --land-near: #666638;
    --land-veg: #4c5c30;
    --land-snow: transparent;
    --land-star: transparent;
    --land-glow: #e8b95c;
  }
  :global(html[data-theme="dark"]) .ascii-landscape[data-biome="steppe"] {
    --land-far: #4a4a30;
    --land-mid: #3a3a22;
    --land-near: #232310;
    --land-veg: #2c3016;
    --land-snow: transparent;
    --land-star: #cfcaa8;
    --land-glow: #ece7c9;
  }

  /* ===== Weather / wildlife overlay ===== */
  .ascii-landscape-weather {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
    font-family: "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: clamp(10px, 1.6vw, 18px);
  }

  .ascii-landscape-weather :global(.wx-bird) {
    position: absolute;
    left: -6%;
    color: var(--text);
    animation-name: wx-fly;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
  }

  .ascii-landscape-weather :global(.wx-particle) {
    position: absolute;
    top: -6%;
    animation-name: wx-fall;
    animation-timing-function: linear;
  }

  .ascii-landscape-weather :global(.wx-snow) { color: var(--text-2); }
  .ascii-landscape-weather :global(.wx-rain) { color: var(--muted); }

  /* Positioned/rotated via the Web Animations API in JS (it samples the
     actual terrain height as it crosses, not a flat CSS keyframe path),
     so only static appearance lives here. Deliberately smaller than
     birds/particles. */
  .ascii-landscape-weather :global(.wx-tumbleweed) {
    position: absolute;
    left: -6%;
    color: var(--muted);
    font-size: 0.6em;
    font-weight: 800;
  }

  @keyframes wx-fly {
    from { left: -6%; }
    to { left: 106%; }
  }

  @keyframes wx-fall {
    0% { top: -6%; opacity: 1; }
    100% { top: 106%; opacity: 0.85; }
  }

  /* Gentle atmospheric breathing on the two background layers — subtle,
     and deliberately not synced (different durations) so it doesn't
     read as a single flat pulse. */
  @keyframes wx-shimmer-far {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @keyframes wx-shimmer-mid {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.75; }
  }
</style>
