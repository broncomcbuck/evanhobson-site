---
const currentPath = Astro.url.pathname;
const isActive = (href) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<nav class="topnav">
  <div class="nav-inner">
    <div class="links">
      <a class={isActive("/") ? "active" : ""} href="/">Home</a>
      <a class={isActive("/about") ? "active" : ""} href="/about">About</a>
      <a class={isActive("/research") ? "active" : ""} href="/research">Research</a>
      <a class={isActive("/projects") ? "active" : ""} href="/projects">Projects</a>
      <a class={isActive("/writing") ? "active" : ""} href="/writing">Writing</a>
      <a class={isActive("/cv") ? "active" : ""} href="/cv">CV</a>
    </div>

  </div>
</nav>

<style>
.topnav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--nav-h);
  display: flex;
  justify-content: center;
  background: var(--paper);
  border-bottom: 1px solid var(--ink);
  z-index: 5000;
}

.nav-inner {
  width: min(1100px, calc(100% - 3rem));
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.2rem 1.1rem;
}

.links a {
  font-size: 0.98rem;
  text-decoration: none;
  color: var(--ink-2);
  border-bottom: 2px solid transparent;
  padding-bottom: 2px;
}

.links a.active {
  color: var(--ink);
  border-bottom-color: var(--contour);
}

@media (max-width: 520px) {
  .nav-inner {
    width: calc(100% - 2rem);
  }

  .links {
    gap: 0.2rem 0.7rem;
  }

  .links a {
    font-size: 0.86rem;
  }
}
</style>
