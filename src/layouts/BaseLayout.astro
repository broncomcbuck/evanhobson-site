---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";

const {
  title = "Evan Hobson — Ecological Modeling",
  description = "Ecological modeling, wildlife movement, and computational analysis by Evan Hobson.",
  canonical,
} = Astro.props;

const canonicalUrl =
  typeof canonical === "string" && canonical.length > 0 ? canonical : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta name="theme-color" content="#F8F7F4" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
    <script is:inline src="/scripts/theme-toggle.js"></script>
  </head>

  <body>
    <NavBar />

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>&copy; {new Date().getFullYear()} Evan Hobson</span>
        <span class="sep">•</span>
        <a href="mailto:evanjhobson@gmail.com">evanjhobson@gmail.com</a>
        <span class="sep">•</span>
        <a href="https://github.com/broncomcbuck" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    margin-top: 3rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--border);
  }

  .site-footer-inner {
    width: min(1100px, calc(100% - 3rem));
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--muted);
    text-align: center;
  }

  .site-footer-inner .sep {
    opacity: 0.6;
  }

  .site-footer-inner a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--muted) 45%, transparent);
    padding-bottom: 1px;
  }

  .site-footer-inner a:hover {
    color: var(--text);
    border-bottom-color: color-mix(in oklab, var(--accent) 55%, transparent);
  }
</style>
