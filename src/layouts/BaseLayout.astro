---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import AsciiLandscape from "../components/AsciiLandscape.astro";

const {
  title = "Evan Hobson — Ecological Modeling",
  description = "Ecological modeling, wildlife movement, and computational analysis by Evan Hobson.",
  canonical,
} = Astro.props;

const canonicalUrl =
  typeof canonical === "string" && canonical.length > 0 ? canonical : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta name="theme-color" content="#e6dcc0" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
    <script is:inline src="/scripts/theme-toggle.js"></script>
  </head>

  <body>
    <NavBar />

    <!-- page-wrap holds the ASCII scene (absolutely positioned, sized
         to this wrapper's full height) and the real content as
         siblings, so the scene reads as one continuous picture behind
         everything: sky at the top, descending through the terrain to
         a dense ground band at the bottom. ground-space reserves real
         height for that ground band instead of squeezing it into
         whatever's left under the page content. -->
    <div class="page-wrap">
      <AsciiLandscape />

      <div class="content-layer">
        <main class="container">
          <slot />
        </main>
        <div class="ground-space" id="ground-space" aria-hidden="true"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>&copy; {new Date().getFullYear()} Evan Hobson</span>
        <span class="sep">•</span>
        <a href="mailto:evanjhobson@gmail.com">evanjhobson@gmail.com</a>
        <span class="sep">•</span>
        <a href="https://github.com/broncomcbuck" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .page-wrap {
    position: relative;
  }

  .content-layer {
    position: relative;
    z-index: 1;
  }

  /* Reserves real vertical room below the page content for the ground
     portion of the ASCII scene to render at proper detail — without
     this it would be squeezed to whatever sliver is left under the
     content instead of a real "surface" at the bottom of the page. */
  .ground-space {
    min-height: 42vh;
  }

  @media (max-width: 700px) {
    .ground-space {
      min-height: 32vh;
    }
  }

  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 1.5rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }

  .site-footer-inner {
    width: min(1100px, calc(100% - 3rem));
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-2);
    text-align: center;
  }

  .site-footer-inner .sep {
    opacity: 0.6;
  }

  .site-footer-inner a {
    color: var(--water);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--water) 45%, transparent);
    padding-bottom: 1px;
  }

  .site-footer-inner a:hover {
    border-bottom-color: var(--water);
  }
</style>
